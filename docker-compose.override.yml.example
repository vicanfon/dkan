#
# cp docker-compose.override.yml.example docker-compose.override.yml

version: '3.8'

services:
  web:
    # Uncomment to enable Xdebug for PHP debugging
    # environment:
    #   - XDEBUG_MODE=develop,debug
    #   - XDEBUG_CONFIG=client_host=host.docker.internal

    # Uncomment to customize PHP settings
    # environment:
    #   - PHP_MEMORY_LIMIT=1G
    #   - PHP_MAX_EXECUTION_TIME=600

    # Uncomment to mount additional volumes
    # volumes:
    #   - ./custom-config.ini:/usr/local/etc/php/conf.d/custom-config.ini

  # Uncomment to add additional services
